# Copy to docker/.env (git-ignored) and change every value. Never commit docker/.env.
POSTGRES_PASSWORD=change-me-postgres
DRS_DB_PASSWORD=change-me-drs-app
SUPERSET_DB_PASSWORD=change-me-superset-metadata
SUPERSET_READER_PASSWORD=change-me-superset-reader
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPERSET_SECRET_KEY=change-me-long-random-value
SUPERSET_GUEST_TOKEN_SECRET=change-me-another-long-random-value
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin
# The address users open DRS at: the only site allowed to frame Superset dashboards.
DRS_PORTAL_ORIGIN=http://localhost:8080
POSTGRES_PORT=5432
SUPERSET_PORT=8088
# Address of this host the two ports are published on. 127.0.0.1 = this machine only (a trial on
# a PC); 0.0.0.0 = every interface (a server other people's browsers must reach).
POSTGRES_BIND=127.0.0.1
SUPERSET_BIND=0.0.0.0
