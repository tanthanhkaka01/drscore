# Optional, built by you on your own machine: the drscore image plus Microsoft ODBC Driver 18 for
# SQL Server, for report sources that use the default SQL Server driver (pyodbc).
#
# The driver is Microsoft's software, free of charge under Microsoft's own licence terms. It is
# downloaded from packages.microsoft.com while this file is built, and ACCEPT_EULA=Y below is YOUR
# acceptance of those terms (https://aka.ms/odbc18eula). drscore neither contains nor distributes
# it: do not publish an image built from this file unless Microsoft's terms let you.
#
#   docker build -f deploy/docker/Dockerfile -t drscore .
#   docker build -f deploy/docker/Dockerfile.msodbc -t drscore-msodbc .
#   then, in docker-compose.yml:  image: drscore-msodbc   (and no "build:" for that service)
FROM drscore
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg ca-certificates \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql-release.list \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
 && apt-get purge -y --auto-remove gnupg \
 && rm -rf /var/lib/apt/lists/*
