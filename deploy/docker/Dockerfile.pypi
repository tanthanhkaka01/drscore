# drscore in a container, installed from PyPI - no copy of the source is needed.
#
#   docker build -f Dockerfile.pypi --build-arg DRSCORE_VERSION=1.0.0 -t drscore:1.0.0 -t drscore .
#
# Then, in docker-compose.yml, the drscore service takes `image: drscore:1.0.0` and no "build:".
# An upgrade is the same command with the new version, and `docker compose up -d`.
# SQL Server sources with the Microsoft ODBC driver: Dockerfile.msodbc on top of this image.
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata \
 && rm -rf /var/lib/apt/lists/*

ARG DRSCORE_VERSION
RUN test -n "$DRSCORE_VERSION" || { echo "give --build-arg DRSCORE_VERSION=<version on PyPI>"; exit 1; } \
 && pip install --no-cache-dir "drscore==${DRSCORE_VERSION}"

# config/, designs/ and runtime/ of this folder are the installation (mounted).
ENV DRS_HOME=/drs PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /drs
EXPOSE 8080
CMD ["python", "-m", "drscore", "serve"]
