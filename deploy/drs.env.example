# Environment of the DRS service. Copy to /etc/drs/drs.env (Linux, chmod 600, owner root) or set the
# same variables as system environment variables of the service (Windows). Never commit the real file.

# The DRS folder (config/, runtime/, designs/). Needed when DRS is installed with `pip install .`.
DRS_HOME=/opt/drs

# Password of the PostgreSQL login of database.toml ([postgresql] password_env).
DRS_DB_PASSWORD=change-me

# Encryption key of datasource passwords: `python -m drs secret new-key`. Keep a copy in a safe
# place: without it the stored datasource passwords cannot be read and must be typed again.
DRS_SECRET_KEY=change-me

# Only with [bi.superset] enabled = true: password of the Superset service account.
# DRS_SUPERSET_PASSWORD=change-me

# A datasource stored with `--password-env NAME` reads its password from NAME, e.g.:
# HRMS_DB_PASSWORD=change-me
